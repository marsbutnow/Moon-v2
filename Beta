  closeLoginModal();
  updateUserUI();
  enableChat();
  chatSendSystem(acc.display+' joined');
  showToast('Signed in as '+acc.display);
}

function doLogout(){
  if(currentUser)chatSendSystem(currentUser.display+' left');
  currentUser=null;
  updateUserUI();
  disableChat();
  showToast('Signed out');
}

function updateUserUI(){
  const loggedIn=!!currentUser;
  // Non-home topbar
  const ub=document.getElementById('user-badge');
