// ── GLOBAL CHAT (BroadcastChannel + localStorage — same domain, all tabs) ──
const CHAT_KEY  = 'moon-chat-messages';
const CHAT_CH   = 'moon-chat-v1';
const MAX_MSGS  = 60;

let bc=null, chatOpen=false, unreadCount=0;

function connectPS(){
  try{
    bc=new BroadcastChannel(CHAT_CH);
    bc.onmessage=e=>{if(e.data&&e.data.t)handleChatMsg(e.data,false);};
  }catch(ex){
    window.addEventListener('storage',ev=>{
      if(ev.key===CHAT_KEY+'_bc'){
        try{const m=JSON.parse(ev.newValue);if(m&&m.t)handleChatMsg(m,false);}catch(e){}
      }
    });
  }
  updateChatOnline('● live');
  // Load stored history
  try{
    const hist=JSON.parse(localStorage.getItem(CHAT_KEY)||'[]');
    hist.forEach(m=>renderChatMsg(m,true));
    scrollChatBottom();
  }catch(e){}
}

function psend(obj){
  // Save to history
  try{
    const hist=JSON.parse(localStorage.getItem(CHAT_KEY)||'[]');
    hist.push(obj);
    if(hist.length>MAX_MSGS)hist.splice(0,hist.length-MAX_MSGS);
    localStorage.setItem(CHAT_KEY,JSON.stringify(hist));
  }catch(e){}
  // Broadcast to other tabs
  try{
    if(bc)bc.postMessage(obj);
    else localStorage.setItem(CHAT_KEY+'_bc',JSON.stringify({...obj,_r:Math.random()}));
  }catch(e){}
  // Render immediately in this tab
  renderChatMsg(obj,false);
  scrollChatBottom();
  return true;
}

function handleChatMsg(msg,isHistory){
  renderChatMsg(msg);
  if(chatOpen){scrollChatBottom();}
  else if(!isHistory&&msg.t!=='sys'){
    unreadCount++;
    const u=document.getElementById('chat-unread');
    u.textContent=unreadCount>9?'9+':unreadCount;
    u.classList.add('show');
  }
}

function renderChatMsg(msg,isHistory){
  const box=document.getElementById('chat-msgs');
  if(!box)return;
  const div=document.createElement('div');
  if(msg.t==='sys'){
    div.className='chat-msg-sys';
    div.textContent=msg.text;
  } else if(msg.t==='chat'||msg.t==='ann'){
    div.className='chat-msg'+(msg.t==='ann'?' announce':'');
    const now=new Date(msg.ts||Date.now());
    const hh=now.getHours()%12||12, mm=String(now.getMinutes()).padStart(2,'0');
    const isAdmin=msg.role==='admin'||msg.t==='ann';
    div.innerHTML=`<div class="chat-msg-head"><span class="chat-msg-user${isAdmin?' admin':''}">${msg.t==='ann'?'📣 ':''}${escH(msg.user||'?')}</span><span class="chat-msg-time">${hh}:${mm}</span></div><div class="chat-msg-text">${escH(msg.text)}</div>`;
    if(msg.t==='ann'&&!isHistory)showAnnounceBanner(msg.text,msg.user);
  }
  box.appendChild(div);
}

function escH(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function updateChatOnline(t){const el=document.getElementById('chat-online');if(el)el.textContent=t;}
function scrollChatBottom(){const c=document.getElementById('chat-msgs');if(c)requestAnimationFrame(()=>c.scrollTop=c.scrollHeight);}

function toggleChat(){
  chatOpen=!chatOpen;
  document.getElementById('chat-panel').classList.toggle('open',chatOpen);
  if(chatOpen){unreadCount=0;document.getElementById('chat-unread').classList.remove('show');document.getElementById('chat-unread').textContent='';scrollChatBottom();}
}

function enableChat(){
  document.getElementById('chat-input').disabled=false;
  document.getElementById('chat-send').disabled=false;
  document.getElementById('chat-input').placeholder='Message as '+currentUser.display+'...';
  psend({t:'sys',text:currentUser.display+' joined',ts:Date.now()});
}
function disableChat(){
  document.getElementById('chat-input').disabled=true;
  document.getElementById('chat-send').disabled=true;
  document.getElementById('chat-input').placeholder='Sign in to chat...';
}
function chatSendSystem(text){psend({t:'sys',text,ts:Date.now()});}

function sendChatMsg(){
  if(!currentUser){openLoginModal();return;}
  const inp=document.getElementById('chat-input');
  const text=inp.value.trim();if(!text)return;inp.value='';
  psend({t:'chat',user:currentUser.display,role:currentUser.role,text,ts:Date.now()});
}

function sendAnnouncement(){
  if(!currentUser||currentUser.role!=='admin')return;
  const inp=document.getElementById('announce-input');
  const text=inp.value.trim();if(!text)return;inp.value='';
  psend({t:'ann',user:currentUser.display,role:'admin',text,ts:Date.now()});showToast('📣 Broadcast sent!');
}

// Announcement overlay banner (30s auto-dismiss)
let annBTimer=null;
function showAnnounceBanner(text,user){
  let b=document.getElementById('ann-ov');
  if(!b){
    b=document.createElement('div');b.id='ann-ov';
    b.style.cssText="position:fixed;top:0;left:0;right:0;z-index:9400;background:linear-gradient(135deg,rgba(20,14,0,.97),rgba(35,25,0,.97));border-bottom:2px solid #f59e0b;padding:10px 48px 8px 18px;font-family:'JetBrains Mono',monospace;display:none;backdrop-filter:blur(12px);";
    b.innerHTML='<span style="color:#f59e0b;font-size:9px;letter-spacing:2px;margin-right:10px;">📣 ANNOUNCEMENT</span><span id="ann-ov-txt" style="font-size:12px;color:#fde68a;font-family:Inter,sans-serif;"></span><button onclick="closeAnnBanner()" style="position:absolute;top:8px;right:12px;background:none;border:none;color:#888;cursor:pointer;font-size:15px;line-height:1;">✕</button><div style="height:2px;background:rgba(245,158,11,.2);margin-top:7px;border-radius:1px;overflow:hidden;"><div id="ann-ov-bar" style="height:100%;background:#f59e0b;width:100%;transition:none;"></div></div>';
    document.body.appendChild(b);
  }
  document.getElementById('ann-ov-txt').textContent=text;
  b.style.display='block';
  const bar=document.getElementById('ann-ov-bar');
  bar.style.transition='none';bar.style.width='100%';
  requestAnimationFrame(()=>requestAnimationFrame(()=>{bar.style.transition='width 30s linear';bar.style.width='0%';}));
  const appEl=document.getElementById('app');
  appEl.style.marginTop=(b.offsetHeight||44)+'px';
  if(annBTimer)clearTimeout(annBTimer);
  annBTimer=setTimeout(closeAnnBanner,30000);
}
function closeAnnBanner(){
  const b=document.getElementById('ann-ov');if(b)b.style.display='none';
  document.getElementById('app').style.marginTop='';
  if(annBTimer){clearTimeout(annBTimer);annBTimer=null;}
}

function initChat(){
  document.getElementById('chat-btn').classList.add('show');
