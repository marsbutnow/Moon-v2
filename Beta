    </div>
  </div>
  <div class="rpane on" id="rp1"><div class="rsplit"><textarea class="rcode" id="re1" placeholder="<!-- Tab 1 -->"></textarea><div class="r-divider" id="rdiv1" data-pane="1"></div><iframe class="rpreview" id="rv1"></iframe></div></div>
  <div class="rpane" id="rp2"><div class="rsplit"><textarea class="rcode" id="re2" placeholder="<!-- Tab 2 -->"></textarea><div class="r-divider" id="rdiv2" data-pane="2"></div><iframe class="rpreview" id="rv2"></iframe></div></div>
  <div class="rpane" id="rp3"><div class="rsplit"><textarea class="rcode" id="re3" placeholder="<!-- Tab 3 -->"></textarea><div class="r-divider" id="rdiv3" data-pane="3"></div><iframe class="rpreview" id="rv3"></iframe></div></div>
  <div class="rpane" id="rp4"><div class="rsplit"><textarea class="rcode" id="re4" placeholder="<!-- Tab 4 -->"></textarea><div class="r-divider" id="rdiv4" data-pane="4"></div><iframe class="rpreview" id="rv4"></iframe></div></div>
</div>

<div id="app">
  <!-- SIDEBAR -->
  <div id="sidebar">
    <div class="sb-logo">Moon <span>v2</span></div>
    <nav class="sb-nav">
      <div class="sb-item active" onclick="goPage('home')" id="sbi-home">
        <span class="sb-icon">/</span><span class="sb-nav-label">Home</span>
      </div>
      <div class="sb-item" onclick="goPage('games')" id="sbi-games">
        <span class="sb-icon">#</span><span class="sb-nav-label">Games</span>
      </div>
      <div class="sb-item" onclick="goPage('proxy')" id="sbi-proxy">
        <span class="sb-icon">~</span><span class="sb-nav-label">Proxy</span>
      </div>
      <div class="sb-item" onclick="goPage('links')" id="sbi-links">
        <span class="sb-nav-label" style="margin-left:0;font-family:'JetBrains Mono',monospace;font-size:13px;">Links</span>
      </div>

      <div class="sb-sep"></div>
      <div class="sb-section" style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--dim);padding:6px 10px 2px;text-transform:uppercase;">Tools</div>

      <div class="sb-item" onclick="document.getElementById('html-runner').classList.add('open')" id="sbi-runner">
        <span class="sb-icon">&lt;</span><span class="sb-nav-label">HTML Runner</span>
