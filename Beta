#game-viewer-content iframe{position:absolute;inset:0;width:100%;height:100%;border:none;}

/* ── BOOT LOADING SCREEN ── */
#boot-screen{
  position:fixed;inset:0;z-index:999999;
  background:#000;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:0;
  font-family:'JetBrains Mono',monospace;
}
#boot-screen.done{opacity:0;transition:opacity .5s;pointer-events:none;}
.boot-logo{
  font-size:40px;font-weight:900;letter-spacing:4px;
  color:#7c6aff;text-shadow:0 0 30px rgba(124,106,255,.6);
  margin-bottom:6px;font-family:'Courier New',monospace;
}
.boot-sub{font-size:11px;color:#3a3a5a;letter-spacing:3px;margin-bottom:32px;}
.boot-bar-wrap{
  width:400px;max-width:90vw;height:3px;
  background:#1a1a2a;border-radius:2px;overflow:hidden;margin-bottom:16px;
}
.boot-bar{
  height:100%;background:linear-gradient(90deg,#7c6aff,#a89cff);
  width:0%;transition:width .08s linear;border-radius:2px;
}
.boot-log{
  width:400px;max-width:90vw;height:180px;overflow:hidden;
  display:flex;flex-direction:column;justify-content:flex-end;gap:2px;
  padding:8px 0;
}
.boot-line{
  font-size:10px;color:#2a2a4a;letter-spacing:.5px;
  display:flex;gap:8px;line-height:1.6;
  animation:bootfade .1s ease both;
}
.boot-line.active{color:#a89cff;}
.boot-line.done{color:#3a5a3a;}
.boot-line .bl-status{flex-shrink:0;width:14px;}
.boot-line .bl-path{color:#4a4a6a;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.boot-line .bl-size{color:#2a2a4a;flex-shrink:0;}
.boot-line.done .bl-path{color:#4a8a4a;}
.boot-line.done .bl-size{color:#4a8a4a;}
.boot-pct{font-size:11px;color:#5a5a8a;letter-spacing:2px;margin-top:4px;}
@keyframes bootfade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}


@keyframes moonFloat{
  0%,100%{transform:translateY(0) rotate(0deg);filter:drop-shadow(0 0 40px rgba(180,190,220,.35)) drop-shadow(0 0 80px rgba(120,140,200,.2));}
  25%{transform:translateY(-10px) rotate(.5deg);filter:drop-shadow(0 0 55px rgba(180,190,220,.5)) drop-shadow(0 0 100px rgba(120,140,200,.3));}
  75%{transform:translateY(5px) rotate(-.3deg);filter:drop-shadow(0 0 30px rgba(180,190,220,.25)) drop-shadow(0 0 60px rgba(120,140,200,.15));}
}
.moon-wordmark-img{display:flex;align-items:center;justify-content:center;}

</style>
</head>
<body>

<!-- BOOT LOADING SCREEN -->
<div id="boot-screen">
  <img src="data:image/png;base64," alt="Moon" style="width:80px;height:80px;filter:drop-shadow(0 0 20px rgba(180,190,220,.5));border-radius:50%;margin-bottom:8px;">
  <div class="boot-sub">// loading game library...</div>
  <div class="boot-bar-wrap"><div class="boot-bar" id="boot-bar"></div></div>
  <div class="boot-log" id="boot-log"></div>
  <div class="boot-pct" id="boot-pct">0%</div>
</div>

<!-- INLINE GAME VIEWER -->
<div id="game-viewer">
  <div id="game-viewer-bar">
    <span id="game-viewer-title">Loading...</span>
    <button class="gv-btn" id="gv-fs-btn" onclick="toggleGameFS()">⛶ Fullscreen</button>
    <button class="gv-btn red" onclick="closeGameViewer()">✕ Close</button>
  </div>
  <div id="game-viewer-content" style="flex:1;position:relative;background:#000;overflow:hidden;"></div>
</div>


<!-- SITE GATE -->
<div id="pwscreen">
  <div class="pw-box">
    <img src="data:image/png;base64," alt="Moon" style="width:72px;height:72px;filter:drop-shadow(0 0 16px rgba(180,190,220,.5));border-radius:50%;display:block;margin:0 auto;">
    <div class="pw-title">Private Access</div>
    <div class="pw-sub">enter access code</div>
    <input class="pw-inp" id="pwinp" type="password" placeholder="••••" maxlength="24" autocomplete="off" onkeydown="if(event.key==='Enter')checkPW()">
    <button class="pw-btn" onclick="checkPW()">Enter</button>
    <div class="pw-err" id="pwerr"></div>
  </div>
</div>

<!-- ACCOUNT LOGIN MODAL -->
<div id="login-modal">
  <div class="lm-box">
    <div class="lm-title">Sign In</div>
    <div class="lm-sub">moon account · chat access</div>
    <input class="lm-inp" id="lm-user" type="text" placeholder="Username" autocomplete="off" onkeydown="if(event.key==='Enter')document.getElementById('lm-pass').focus()">
    <input class="lm-inp" id="lm-pass" type="password" placeholder="Password" autocomplete="off" onkeydown="if(event.key==='Enter')doAccountLogin()">
    <button class="lm-btn" onclick="doAccountLogin()">Sign In</button>
    <div class="lm-err" id="lm-err"></div>
  </div>
</div>

<!-- HTML RUNNER -->
<div id="html-runner">
  <div class="run-topbar">
    <span class="run-title">HTML Runner</span>
