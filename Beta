function runBootScreen(){
  const screen=document.getElementById('boot-screen');
  const bar=document.getElementById('boot-bar');
  const log=document.getElementById('boot-log');
  const pct=document.getElementById('boot-pct');
  if(!screen)return;
  const DURATION=3000;
  const total=BOOT_ASSETS.length;

  function fmt(n){
    if(n>1024*1024)return(n/1024/1024).toFixed(1)+' MB';
    if(n>1024)return(n/1024).toFixed(0)+' KB';
    return n+' B';
  }

  function addLine(asset,isDone){
    const div=document.createElement('div');
    div.className='boot-line'+(isDone?' done':' active');
    div.innerHTML='<span class="bl-status">'+(isDone?'✓':'›')+'</span><span class="bl-path">'+asset.path+'</span><span class="bl-size">'+fmt(asset.size)+'</span>';
    log.appendChild(div);
    while(log.children.length>8)log.removeChild(log.firstChild);
  }

  function loadNext(i){
    if(i>=total){
      bar.style.width='100%';
      pct.textContent='100%';
      if(log.lastChild){log.lastChild.classList.remove('active');log.lastChild.classList.add('done');const s=log.lastChild.querySelector('.bl-status');if(s)s.textContent='✓';}
      setTimeout(()=>{
        screen.classList.add('done');
        setTimeout(()=>{
          if(screen.parentNode)screen.parentNode.removeChild(screen);
          const pw=document.getElementById('pwscreen');
          if(pw){pw.classList.add('show');document.getElementById('pwinp').focus();}
        },520);
      },300);
      return;
    }
    const asset=BOOT_ASSETS[i];
    const delay=(DURATION/total)*(0.5+Math.random());
    addLine(asset,false);
    const progress=(i+1)/total;
    bar.style.width=(progress*100).toFixed(1)+'%';
    pct.textContent=Math.round(progress*100)+'%';
    if(log.children.length>1){
      const prev=log.children[log.children.length-2];
      if(prev){prev.classList.remove('active');prev.classList.add('done');const s=prev.querySelector('.bl-status');if(s)s.textContent='✓';}
    }
    setTimeout(()=>loadNext(i+1),delay);
  }
  loadNext(0);
}
