(function(){
  const canvas=document.getElementById('star-canvas');
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  let W,H,stars=[],particles=[];
  const STAR_COUNT=90;

  function resize(){
    W=canvas.width=canvas.offsetWidth;
    H=canvas.height=canvas.offsetHeight;
  }

  function randBetween(a,b){return a+(Math.random()*(b-a));}

  function makeStars(){
    stars=[];
    for(let i=0;i<STAR_COUNT;i++){
      stars.push({
        x:Math.random()*W, y:Math.random()*H,
        r:randBetween(.5,2.2),
        baseR:randBetween(.5,2.2),
        glow:randBetween(.3,.9),
        glowDir:Math.random()<.5?1:-1,
        glowSpeed:randBetween(.003,.012),
        explodeTimer:Math.floor(randBetween(120,800)),
        color:randColor(),
        alpha:randBetween(.4,1),
      });
    }
  }

  function randColor(){
    const palettes=[
      ['#ffffff','#e8e0ff','#c0b8ff'],
      ['#ff88cc','#ff4488','#ffaadd'],
      ['#88ccff','#44aaff','#aaddff'],
      ['#88ffdd','#44ffcc','#aaffee'],
      ['#ffdd88','#ffcc44','#ffeeaa'],
    ];
    const p=palettes[Math.floor(Math.random()*palettes.length)];
    return p[Math.floor(Math.random()*p.length)];
  }

  function explodeStar(s){
    const count=Math.floor(randBetween(6,14));
    for(let i=0;i<count;i++){
      const angle=(Math.PI*2/count)*i+Math.random()*.4;
      const speed=randBetween(1.2,3.8);
      particles.push({
        x:s.x, y:s.y,
        vx:Math.cos(angle)*speed,
        vy:Math.sin(angle)*speed,
        r:randBetween(.5,1.8),
        alpha:1,
        fade:randBetween(.018,.035),
        color:s.color,
      });
    }
    // reset star to new position
    s.x=Math.random()*W;
    s.y=Math.random()*H;
    s.explodeTimer=Math.floor(randBetween(180,900));
    s.color=randColor();
    s.alpha=0;
  }

  function drawStar(s){
    ctx.save();
    ctx.globalAlpha=s.alpha;
    ctx.beginPath();
    ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
    ctx.fillStyle=s.color;
    ctx.shadowColor=s.color;
    ctx.shadowBlur=s.r*5*s.glow;
    ctx.fill();
    ctx.restore();
  }

  function tick(){
    ctx.clearRect(0,0,W,H);

    stars.forEach(s=>{
      // pulse glow
      s.glow+=s.glowSpeed*s.glowDir;
      if(s.glow>1){s.glow=1;s.glowDir=-1;}
      if(s.glow<.2){s.glow=.2;s.glowDir=1;}
      // fade in after explode
      if(s.alpha<1)s.alpha=Math.min(1,s.alpha+.008);
      // countdown to explode
      s.explodeTimer--;
      if(s.explodeTimer<=0){explodeStar(s);}
      drawStar(s);
    });

    // particles
    particles=particles.filter(p=>{
      p.x+=p.vx; p.y+=p.vy;
      p.vx*=.94; p.vy*=.94;
      p.alpha-=p.fade;
      if(p.alpha<=0)return false;
      ctx.save();
      ctx.globalAlpha=p.alpha;
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle=p.color;
      ctx.shadowColor=p.color;
      ctx.shadowBlur=p.r*4;
      ctx.fill();
      ctx.restore();
      return true;
    });

    requestAnimationFrame(tick);
  }

  function init(){
    resize();makeStars();tick();
  }

  // Only run when home page is visible
  const pg=document.getElementById('pg-home');
  if(pg){
    const obs=new ResizeObserver(()=>{resize();if(!stars.length)makeStars();});
    obs.observe(pg);
    init();
  }
  window.addEventListener('resize',()=>{resize();});
})();


