      <button class="rtab on" id="rt1" onclick="switchRT(1)">1</button>
      <button class="rtab" id="rt2" onclick="switchRT(2)">2</button>
      <button class="rtab" id="rt3" onclick="switchRT(3)">3</button>
      <button class="rtab" id="rt4" onclick="switchRT(4)">4</button>
